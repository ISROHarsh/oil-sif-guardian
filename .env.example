# OIL-SIF Guardian Environment Configuration Template
# COPY TO .env FOR LOCAL OVERRIDES - NEVER COMMIT .env TO VERSION CONTROL

# Application
ENVIRONMENT=development
DEBUG=True
APP_NAME=OIL-SIF Guardian
API_V1_STR=/api/v1
SECRET_KEY=development-secret-key-change-in-production-oil-sif-2026

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Database
# For quick local testing, SQLite is used when POSTGRES_SERVER is empty.
# In Docker/Production, set PostgreSQL connection details.
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oil_sif_guardian
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=sqlite:///./oil_sif_guardian.db

# ML & Inference
MODEL_VERSION=psif-v1.0-baseline
DEVICE=cpu
PSIF_HIGH_THRESHOLD=0.70
PSIF_REVIEW_THRESHOLD=0.40

# Logging & Auditing
LOG_LEVEL=INFO
ENABLE_AUDIT_LOG=True
